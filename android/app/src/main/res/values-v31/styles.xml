<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ Splash Theme -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- Disable system splash icon (otherwise Samsung shows launcher icon) -->
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>

        <!-- Force black splash background -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>

        <!-- Important: Hide Samsung’s circular background behind the icon -->
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>

        <!-- Flutter UI background -->
        <item name="android:windowBackground">@android:color/black</item>

    </style>

    <!-- Normal app theme -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
